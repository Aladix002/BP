<?xml version="1.0"?>
<launch>
  <arg name="use_sim_time" default="true" />
  <arg name="model" default="$(find-pkg-share waver_description)/urdf/waver.xacro" />
  <arg name="sim_control" default="gazebo" description="(gazebo/ros2)" />
  <arg name="camera_type" default="raspi" description="(raspi/depth)" />
  <!-- Gazebo already publishes /joint_states via ros_gz_bridge; a second publisher corrupts TF for movable joints (wheels). -->
  <arg name="publish_joint_states" default="true" description="Set false when Gazebo (or hardware) publishes /joint_states" />
  <!-- When true, accept joint_states even if header stamps are odd (helps Gazebo bridge + RSP throttling). -->
  <arg name="rsp_ignore_joint_timestamp" default="false" />

  <node name="joint_state_publisher" pkg="joint_state_publisher" exec="joint_state_publisher"
        if="$(var publish_joint_states)" />

  <!-- Robot State Publisher -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)" />
    <param name="ignore_timestamp" value="$(var rsp_ignore_joint_timestamp)" />
    <param name="robot_description"
      value="$(command 'xacro $(var model) sim_control:=$(var sim_control) camera_type:=$(var camera_type)')" />
  </node>

</launch>
