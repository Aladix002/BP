<?xml version='1.0'?>
<sdf version='1.9'>
  <world name='waver_world'>

    <!--
      System pluginy:
      - Physics: fyzika sveta,
      - UserCommands: runtime prikazy (spawn/delete),
      - SceneBroadcaster: stream sceny do GUI,
      - Imu/Sensors: simulacia senzorov.
    -->
    <plugin filename="gz-sim-physics-system"       name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"  name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system"            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system"        name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!--
      Fyzika:
      max_step_size 0.001 => 1 kHz krok.
      real_time_factor 1.0 => ciel je realny cas.
    -->
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!--
      Scene + svetla:
      ambient + background ovplyvnuju citatelnost kamery a GUI.
    -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name='sun' type='directional'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <light name='overhead' type='point'>
      <pose>0 0 4 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range><constant>0.3</constant>
        <linear>0.02</linear><quadratic>0.002</quadratic>
      </attenuation>
    </light>

    <!-- Podlaha: velka rovina s trenim. -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name='visual'>
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Vonkajsie steny miestnosti.
      Ciel: uzavriet mapovaci priestor, aby Nav2/SLAM mali jasne hranice.
    -->
    <model name='walls'>
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

    <!-- Juzna stena -->
      <link name='wall_south'>
        <pose>0 -5 1.25 0 0 0</pose>
        <collision name='col'><geometry><box><size>10.3 0.2 2.5</size></box></geometry></collision>
        <visual name='vis'>
          <geometry><box><size>10.3 0.2 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>

    <!-- Severna stena -->
      <link name='wall_north'>
        <pose>0 5 1.25 0 0 0</pose>
        <collision name='col'><geometry><box><size>10.3 0.2 2.5</size></box></geometry></collision>
        <visual name='vis'>
          <geometry><box><size>10.3 0.2 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>

    <!-- Zapadna stena -->
      <link name='wall_west'>
        <pose>-5 0 1.25 0 0 0</pose>
        <collision name='col'><geometry><box><size>0.2 10.3 2.5</size></box></geometry></collision>
        <visual name='vis'>
          <geometry><box><size>0.2 10.3 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>

    <!-- Vychodna stena -->
      <link name='wall_east'>
        <pose>5 0 1.25 0 0 0</pose>
        <collision name='col'><geometry><box><size>0.2 10.3 2.5</size></box></geometry></collision>
        <visual name='vis'>
          <geometry><box><size>0.2 10.3 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      Vnutorne prekazky:
      vytvaraju realnejsi scenar pre planner + local controller.
    -->

    <!-- Box A: vlavo vpredu -->
    <model name='obstacle_a'>
      <static>true</static>
      <pose>-2.5 2.0 0.4 0 0 0</pose>
      <link name='link'>
        <collision name='col'><geometry><box><size>0.4 1.2 0.8</size></box></geometry></collision>
        <visual name='vis'>
          <geometry><box><size>0.4 1.2 0.8</size></box></geometry>
          <material><ambient>0.5 0.35 0.1 1</ambient><diffuse>0.6 0.45 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Box B: vpravo vpredu -->
    <model name='obstacle_b'>
      <static>true</static>
      <pose>2.5 -2.0 0.4 0 0 0</pose>
      <link name='link'>
        <collision name='col'><geometry><box><size>0.4 1.2 0.8</size></box></geometry></collision>
        <visual name='vis'>
          <geometry><box><size>0.4 1.2 0.8</size></box></geometry>
          <material><ambient>0.3 0.3 0.55 1</ambient><diffuse>0.4 0.4 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segment steny v strede -->
    <model name='obstacle_c'>
      <static>true</static>
      <pose>0.0 2.5 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='col'><geometry><box><size>1.8 0.3 1.0</size></box></geometry></collision>
        <visual name='vis'>
          <geometry><box><size>1.8 0.3 1.0</size></box></geometry>
          <material><ambient>0.55 0.4 0.3 1</ambient><diffuse>0.65 0.5 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Stlp vpravo vzadu -->
    <model name='obstacle_d'>
      <static>true</static>
      <pose>2.5 2.5 0.75 0 0 0</pose>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.18</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name='vis'>
          <geometry><cylinder><radius>0.18</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
