<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- CSI kamera model: Gazebo image + camera_info; bridge na ROS topic podla ros_gz_bridge.yaml. -->
  <link name="camera_link">
    <inertial>
      <mass value="0.0035"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.7e-7" iyy="1.8e-7" izz="3.0e-7"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="board">
      <origin xyz="0 0 0"/>
      <geometry><box size="0.010 0.025 0.023"/></geometry>
      <material name="black"/>
    </visual>
    <visual name="lens">
      <origin xyz="0.007 0 0" rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="0.004" length="0.006"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.010 0.025 0.023"/></geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.097 0 0.005" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="camera_link"/>
  </joint>
  <gazebo reference="camera_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
    <sensor name="camera_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>8</update_rate>
      <visualize>false</visualize>
      <topic>camera</topic>
      <camera>
        <horizontal_fov>1.1519</horizontal_fov>
        <image><format>R8G8B8</format><height>480</height><width>640</width></image>
        <clip><near>0.05</near><far>100.0</far></clip>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
      </camera>
    </sensor>
  </gazebo>

</robot>
