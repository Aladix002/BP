<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Lidar je fixne prichyteny na base_link.
    Sensor typ gpu_lidar publikuje topic "scan" na Gazebo strane.
    Cez ros_gz_bridge sa mapuje na ROS topic /scan.
  -->
  <link name="lidar_link">
    <inertial>
      <mass value="0.046"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.2e-5" iyy="1.5e-5" izz="1.9e-5"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="post">
      <origin xyz="0 0 -0.033"/>
      <geometry><cylinder radius="0.007" length="0.036"/></geometry>
      <material name="silver"/>
    </visual>
    <visual name="puck">
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="0.019" length="0.030"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="0.019" length="0.030"/></geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.04 0 0.092" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="lidar_link"/>
  </joint>
  <gazebo reference="lidar_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/Grey</material>
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </ray>
    </sensor>
  </gazebo>

</robot>
