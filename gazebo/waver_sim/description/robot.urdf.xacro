<?xml version="1.0"?>
<robot name="articubot_one" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Koren URDF pre simulaciu (Gazebo / RViz).
    Poradie include: najprv makra (hmotnosti), potom geometria podvozku, Gazebo pluginy pre diff drive,
    potom senzory (lidar, kamera) ako samostatne xacro subory.
  -->
  <xacro:include filename="inertial_macros.xacro"/>
  <xacro:include filename="robot_core.xacro"/>
  <xacro:include filename="gazebo_control.xacro"/>
  <xacro:include filename="lidar.xacro"/>
  <xacro:include filename="camera.xacro"/>

</robot>
