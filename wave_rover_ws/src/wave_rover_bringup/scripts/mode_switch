#!/usr/bin/env python3
"""
Wave Rover interactive mode switcher.

Usage:
  mode_switch                    # interactive menu
  mode_switch --mode manual      # set manual immediately
  mode_switch --mode auto        # set autonomous immediately
  mode_switch --goal 1.5 2.0     # send Nav2 goal (x y), auto mode implied
  mode_switch --save-map ~/map   # save current SLAM map

What it does:
  [1] Manual + SLAM  – you drive, robot maps the environment
  [2] Auto  + Nav2   – click/type a goal, robot drives and avoids obstacles
  [3] Save map       – write current SLAM map to disk
  [4] Send goal      – send a NavigateToPose goal (x, y in map frame)
  [5] Cancel goal    – stop autonomous navigation
  [q] Quit
"""

import argparse
import math
import subprocess
import sys
import threading
import time

import rclpy
from rclpy.action import ActionClient
from rclpy.node import Node
from geometry_msgs.msg import PoseStamped
from nav2_msgs.action import NavigateToPose
from std_msgs.msg import String


class ModeSwitcher(Node):

    def __init__(self):
        super().__init__('mode_switch_cli')

        self._current_mode = 'unknown'
        self._goal_handle  = None
        self._goal_lock    = threading.Lock()

        # Publisher – send mode commands
        self._pub_mode     = self.create_publisher(String, '/mode',     10)
        self._pub_nav_mode = self.create_publisher(String, '/nav_mode', 10)

        # Subscriber – track current mode
        self._sub_mode = self.create_subscription(
            String, '/current_mode', self._mode_cb, 10)

        # Nav2 action client
        self._nav_client = ActionClient(self, NavigateToPose, '/navigate_to_pose')

    def _mode_cb(self, msg: String):
        self._current_mode = msg.data

    def set_mode(self, mode: str):
        msg = String()
        msg.data = mode
        self._pub_mode.publish(msg)
        time.sleep(0.2)
        print(f'  → Mode: {mode.upper()}')

    def send_goal(self, x: float, y: float, yaw_deg: float = 0.0):
        if not self._nav_client.wait_for_server(timeout_sec=3.0):
            print('  [!] Nav2 action server not available – is nav stack running?')
            return

        yaw_rad = math.radians(yaw_deg)
        goal = NavigateToPose.Goal()
        goal.pose = PoseStamped()
        goal.pose.header.frame_id = 'map'
        goal.pose.header.stamp = self.get_clock().now().to_msg()
        goal.pose.pose.position.x = x
        goal.pose.pose.position.y = y
        goal.pose.pose.position.z = 0.0
        goal.pose.pose.orientation.z = math.sin(yaw_rad / 2)
        goal.pose.pose.orientation.w = math.cos(yaw_rad / 2)

        print(f'  → Sending goal: x={x:.2f} y={y:.2f} yaw={yaw_deg:.0f}°')
        future = self._nav_client.send_goal_async(
            goal, feedback_callback=self._feedback_cb)
        future.add_done_callback(self._goal_accepted_cb)

    def _goal_accepted_cb(self, future):
        handle = future.result()
        if not handle.accepted:
            print('  [!] Goal rejected by Nav2')
            return
        print('  Goal accepted – robot is navigating...')
        with self._goal_lock:
            self._goal_handle = handle
        handle.get_result_async().add_done_callback(self._goal_result_cb)

    def _goal_result_cb(self, future):
        result = future.result()
        status = result.status
        if status == 4:   # SUCCEEDED
            print('\n  [OK] Goal reached!')
        elif status == 5: # CANCELED
            print('\n  [--] Goal cancelled.')
        else:
            print(f'\n  [!] Goal failed (status={status})')
        with self._goal_lock:
            self._goal_handle = None

    def _feedback_cb(self, msg):
        dist = msg.feedback.distance_remaining
        # Print on same line
        print(f'\r  Distance remaining: {dist:.2f} m   ', end='', flush=True)

    def cancel_goal(self):
        with self._goal_lock:
            handle = self._goal_handle
        if handle is None:
            print('  No active goal.')
            return
        handle.cancel_goal_async()
        print('  Cancelling goal...')

    def save_map(self, path: str):
        print(f'  Saving map to {path} ...')
        try:
            result = subprocess.run(
                ['ros2', 'run', 'nav2_map_server', 'map_saver_cli', '-f', path],
                timeout=10, capture_output=True, text=True,
            )
            if result.returncode == 0:
                print(f'  [OK] Map saved: {path}.pgm + {path}.yaml')
            else:
                print(f'  [!] map_saver failed: {result.stderr.strip()}')
        except subprocess.TimeoutExpired:
            print('  [!] map_saver timed out')
        except FileNotFoundError:
            print('  [!] ros2 command not found – is ROS2 sourced?')


def _menu(node: ModeSwitcher):
    print('\n' + '=' * 50)
    print('  Wave Rover Mode Switcher')
    print(f'  Current mode: {node._current_mode}')
    print('=' * 50)
    print('  [1]  Manual + SLAM  (you drive, robot maps)')
    print('  [2]  Auto  + Nav2   (robot navigates to goals)')
    print('  [3]  Save map')
    print('  [4]  Send Nav2 goal (enter x y)')
    print('  [5]  Cancel current goal')
    print('  [q]  Quit')
    print('=' * 50)


def _run_interactive(node: ModeSwitcher):
    spin_thread = threading.Thread(
        target=rclpy.spin, args=(node,), daemon=True)
    spin_thread.start()

    time.sleep(0.5)  # let subscriber receive current mode

    while rclpy.ok():
        _menu(node)
        try:
            choice = input('  Choice: ').strip().lower()
        except (EOFError, KeyboardInterrupt):
            break

        if choice == '1':
            node.set_mode('manual')
            node._pub_nav_mode.publish(String(data='slam'))
            print('  SLAM started. Drive the robot to build the map.')
            print('  Teleop: ros2 run teleop_twist_keyboard teleop_twist_keyboard '
                  '--ros-args -r cmd_vel:=cmd_vel_teleop')

        elif choice == '2':
            node.set_mode('auto')
            node._pub_nav_mode.publish(String(data='nav'))
            print('  Robot is in autonomous mode.')
            print('  In RViz: click the "Nav2 Goal" button (target icon) and '
                  'click on the map.')
            print('  Or use option [4] to type coordinates.')

        elif choice == '3':
            path = input('  Save path (default ~/wave_rover_map): ').strip()
            if not path:
                import os
                path = os.path.expanduser('~/wave_rover_map')
            node.save_map(path)

        elif choice == '4':
            node.set_mode('auto')
            try:
                coords = input('  Enter goal: x y [yaw_deg]  e.g. "1.5 2.0" or "1.5 2.0 90": ')
                parts = coords.strip().split()
                x = float(parts[0])
                y = float(parts[1])
                yaw = float(parts[2]) if len(parts) > 2 else 0.0
                node.send_goal(x, y, yaw)
            except (ValueError, IndexError):
                print('  [!] Invalid input. Example: 1.5 2.0')

        elif choice == '5':
            node.cancel_goal()

        elif choice in ('q', 'quit', 'exit'):
            break
        else:
            print('  Unknown choice.')

    node.destroy_node()
    rclpy.shutdown()


def main():
    parser = argparse.ArgumentParser(description='Wave Rover mode switcher')
    parser.add_argument('--mode',     choices=['manual', 'auto'],
                        help='Set mode directly and exit')
    parser.add_argument('--goal',     nargs='+', metavar='COORD',
                        help='Send goal: x y [yaw_deg]')
    parser.add_argument('--save-map', metavar='PATH',
                        help='Save SLAM map to path')
    args = parser.parse_args()

    rclpy.init()
    node = ModeSwitcher()

    # Non-interactive one-shot commands
    if args.mode or args.goal or args.save_map:
        spin_thread = threading.Thread(
            target=rclpy.spin, args=(node,), daemon=True)
        spin_thread.start()
        time.sleep(0.3)

        if args.mode:
            node.set_mode(args.mode)

        if args.save_map:
            node.save_map(args.save_map)

        if args.goal:
            try:
                x   = float(args.goal[0])
                y   = float(args.goal[1])
                yaw = float(args.goal[2]) if len(args.goal) > 2 else 0.0
                node.set_mode('auto')
                node.send_goal(x, y, yaw)
                time.sleep(2)  # give time for feedback
            except (ValueError, IndexError):
                print('Usage: --goal x y [yaw_deg]')

        node.destroy_node()
        rclpy.shutdown()
    else:
        _run_interactive(node)


if __name__ == '__main__':
    main()
