<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wave_rover_bringup</name>
  <version>1.0.0</version>
  <description>Top-level bringup launch files for Wave Rover robot system.</description>
  <maintainer email="robot@waverover.local">Wave Rover</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>wave_rover_control</exec_depend>
  <exec_depend>wave_rover_sensors</exec_depend>
  <exec_depend>wave_rover_navigation</exec_depend>
  <exec_depend>wave_rover_utils</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rosbridge_suite</exec_depend>
  <exec_depend>web_video_server</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
