[Unit]
Description=PRP Project (teleop + bridge, autonómna jazda s lidarom)
After=network.target ld19-lidar.service
Wants=network-online.target
Requires=ld19-lidar.service

[Service]
Type=simple
User=aladix
Group=aladix
Environment="HOME=/home/aladix"
Environment="USER=aladix"
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/aladix/Desktop/BP/install/setup.bash && ros2 run prp_project prp_project'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
